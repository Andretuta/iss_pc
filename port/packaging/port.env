# Port profile read by the packaging scripts and the CI: one file per port, same keys everywhere.
PORT_NAME="inFAMOUS Second Son"     # executable, window and menu entry name
PORT_SLUG="infamous"                # package prefix: <slug>-linux-x86_64.tar.gz, <slug>-windows-x86_64.zip
PORT_LAUNCHER="infamous_launcher.py"  # port/launcher/<file>, frozen with PyInstaller
PORT_ICON="infamous"                # port/launcher/<icon>.png and .ico (original art, never the game's)
PORT_TITLE_ID="CUSA00223"
